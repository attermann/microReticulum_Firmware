        "extra_flags": "-DARDUINO_MASN_HTRA62 -DNRF52840_XXAA",
        "f_cpu": "64000000L",
        "usb_product": "nice!nano",
        "mcu": "nrf52840",
        "variant": "masn_ht_ra62",
        "bsp": {
            "name": "adafruit"
        },
        "softdevice": {
            "sd_flags": "-DS140",
